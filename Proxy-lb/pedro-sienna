# Balanceador para el Backend 
upstream sienna_backend {
    server 10.0.2.2:4000;
    server 10.0.2.5:4000;
}

# Balanceador para el Frontend
upstream frontend_sienna {
    server 10.0.2.2:3000;
    server 10.0.2.5:3000;
}

server {
    listen 80;
    server_name _;

    # Tráfico del Frontend
    location / {
        proxy_pass http://frontend_sienna;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Tráfico del Backend
    location /api/ {
        proxy_pass http://sienna_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Monitoreo 
        location /monitoreo/ {
        proxy_pass http://127.0.0.1:19999/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
